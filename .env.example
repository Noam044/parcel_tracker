# Token public Mapbox (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Token Mapbox secret (facultatif) réservé au géocodage côté serveur. S'il est défini, le token public
# ci-dessus peut être restreint aux URL du site dans le tableau de bord Mapbox.
MAPBOX_GEOCODING_TOKEN=

# Clé API 17TRACK (https://api.17track.net/)
TRACK17_API_KEY=votre_cle_17track_ici

# Protection du quota 17TRACK (chaque nouveau numéro suivi coûte une unité)
# Nouveaux numéros enregistrés par jour, tous visiteurs confondus (0 = aucun)
TRACK17_DAILY_REGISTER_LIMIT=5
# Unités de quota gardées en réserve : en dessous, plus aucun enregistrement
TRACK17_QUOTA_RESERVE=20
